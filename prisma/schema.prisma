generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// STUDENT TRIALS
// ============================================

model StudentTrial {
  id               Int       @id @default(autoincrement())
  firstName        String    @map("first_name") @db.VarChar(50)
  lastName         String    @map("last_name") @db.VarChar(50)
  email            String    @db.VarChar(100)
  phone            String    @db.VarChar(20)
  detectedCountry  String?   
  country          String    @db.VarChar(50)
  preferredCourse  String    @map("preferred_course") @db.VarChar(50)
  sessionFor       String    @map("session_for") @db.VarChar(20)
  preferredTeacher String    @map("preferred_teacher") @db.VarChar(20)
  source           String?   @db.VarChar(50)
  preferredDate    DateTime? @map("preferred_date") @db.Date
  preferredTime    String?   @map("preferred_time")
  status           String    @default("pending") @db.VarChar(20)
  captchaToken     String?   @map("captcha_token")
  ipAddress        String?   @map("ip_address") @db.VarChar(45)
  userAgent        String?   @map("user_agent")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("student_trials")
}

// ============================================
// TEACHER APPLICATIONS
// ============================================

// schema.prisma - Updated TeacherApplication model

model TeacherApplication {
  id              Int       @id @default(autoincrement())
  firstName       String    @map("first_name") @db.VarChar(50)
  lastName        String    @map("last_name") @db.VarChar(50)
  gender          String    @db.VarChar(20)
  email           String    @db.VarChar(100)  // ← REMOVED @unique
  countryCode     String?   @map("country_code") @db.VarChar(10)
  mobile          String    @db.VarChar(20)
  country         String    @db.VarChar(50)
  dateOfBirth     DateTime  @map("date_of_birth") @db.Date
  maritalStatus   String    @map("marital_status") @db.VarChar(20)
  nationality     String    @db.VarChar(50)
  occupation      String    @db.VarChar(100)
  aboutMe         String    @map("about_me")
  facebookProfile String    @map("facebook_profile") @db.VarChar(255)
  profileImage    String?   @map("profile_image") @db.VarChar(500)
  education       String    @db.VarChar(50)
  experience      String    @db.VarChar(50)
  motherLanguage  String    @map("mother_language") @db.VarChar(50)
  otherLanguage   String    @map("other_language") @db.VarChar(50)
  cvFilePath      String?   @map("cv_file_path") @db.VarChar(500)
  audioFilePath   String?   @map("audio_file_path") @db.VarChar(500)
  profileImagePublicId String? @map("profile_image_public_id") @db.VarChar(200)
  cvPublicId        String? @map("cv_public_id") @db.VarChar(200)
  audioPublicId     String? @map("audio_public_id") @db.VarChar(200)
  status          String    @default("pending") @db.VarChar(30)
  ipAddress       String?   @map("ip_address") @db.VarChar(45)
  userAgent       String?   @map("user_agent")
  adminNotes      String?   @map("admin_notes")
  reviewedBy      Int?      @map("reviewed_by")
  reviewedAt      DateTime? @map("reviewed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  // Relations
  reviewer        AdminUser? @relation("TeacherReviewer", fields: [reviewedBy], references: [id])

  @@index([email])  // ← ADD THIS for better query performance
  @@index([status])
  @@index([createdAt])
  @@map("teacher_applications")
}

// ============================================
// CONTACT MESSAGES
// ============================================

model ContactMessage {
  id          String   @id @default(cuid())
  fullName    String
  email       String
  phone       String
  subject     String
  message     String
  status      String   @default("unread")
  ipAddress   String?
  userAgent   String?
  referer     String?
  submittedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([submittedAt])
}

// ============================================
// STUDENT REGISTRATIONS
// ============================================

model StudentRegistration {
  id               Int       @id @default(autoincrement())
  studentId        String?   @unique @map("student_id") @db.VarChar(20)
  firstName        String    @map("first_name") @db.VarChar(50)
  lastName         String    @map("last_name") @db.VarChar(50)
  dateOfBirth      DateTime? @map("date_of_birth") @db.Date
  email            String    @unique @db.VarChar(100)
  phone            String    @db.VarChar(20)
  alternativePhone String?   @map("alternative_phone") @db.VarChar(20)
  country          String    @db.VarChar(50)
  city             String?   @db.VarChar(50)
  address          String?
  preferredCourse  String?
  gender           String?   @db.VarChar(20)
  parentName       String?   @map("parent_name") @db.VarChar(100)
  parentPhone      String?   @map("parent_phone") @db.VarChar(20)
  parentEmail      String?   @map("parent_email") @db.VarChar(100)
  courseId         Int?      @map("course_id")
  enrollmentDate   DateTime  @default(now()) @map("enrollment_date") @db.Date
  trialDate        DateTime? @map("trial_date") @db.Date
  status           String    @default("active") @db.VarChar(20)
  notes            String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")
  passwordHash     String?   @map("password_hash") @db.VarChar(255)
  // Relations
  course           Course?   @relation(fields: [courseId], references: [id])
  enrollments      Enrollment[]
  attendances      Attendance[]
  payments         Payment[]
  assessments      Assessment[]

  @@map("student_registrations")
}

// ============================================
// TEACHER REGISTRATIONS
// ============================================

model TeacherRegistration {
  id                   Int       @id @default(autoincrement())
  teacherId            String?   @unique @map("teacher_id") @db.VarChar(20)
  firstName            String    @map("first_name") @db.VarChar(50)
  lastName             String    @map("last_name") @db.VarChar(50)
  email                String    @unique @db.VarChar(100)
  phone                String    @db.VarChar(20)
  country              String    @db.VarChar(50)
  gender               String?   @db.VarChar(20)
  dateOfBirth          DateTime? @map("date_of_birth") @db.Date
  education            String?   @db.VarChar(50)
  qualificationDetails String?   @map("qualification_details")
  experienceYears      Int?      @map("experience_years")
  motherLanguage       String?   @map("mother_language") @db.VarChar(50)
  languages            String?   @db.VarChar(200)
  specializations      String?
  teachingCertificates String?   @map("teaching_certificates")
  profileImage         String?   @map("profile_image") @db.VarChar(255)
  cvFile               String?   @map("cv_file") @db.VarChar(255)
  audioSample          String?   @map("audio_sample") @db.VarChar(255)
  hireDate             DateTime? @map("hire_date") @db.Date
  status               String    @default("active") @db.VarChar(20)
  notes                String?
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at")

  // Relations
  enrollments          Enrollment[]
  classes              Class[]

  @@map("teacher_registrations")
}

// ============================================
// STAFF REGISTRATIONS
// ============================================

model StaffRegistration {
  id              Int       @id @default(autoincrement())
  staffId         String?   @unique @map("staff_id") @db.VarChar(20)
  firstName       String    @map("first_name") @db.VarChar(50)
  lastName        String    @map("last_name") @db.VarChar(50)
  email           String    @unique @db.VarChar(100)
  phone           String    @db.VarChar(20)
  country         String    @db.VarChar(50)
  gender          String?   @db.VarChar(20)
  dateOfBirth     DateTime? @map("date_of_birth") @db.Date
  position        String?   @db.VarChar(50)
  department      String?   @db.VarChar(50)
  education       String?   @db.VarChar(50)
  experienceYears Int?      @map("experience_years")
  joiningDate     DateTime  @default(now()) @map("joining_date") @db.Date
  status          String    @default("active") @db.VarChar(20)
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")
  passwordHash    String?   @map("password_hash") @db.VarChar(255)

  @@map("staff_registrations")
}

// ============================================
// COURSES
// ============================================

model Course {
  id            Int      @id @default(autoincrement())
  courseCode    String?  @unique @map("course_code") @db.VarChar(20)
  name          String   @db.VarChar(100)
  description   String?
  category      String?  @db.VarChar(50)
  level         String?  @db.VarChar(50)
  durationWeeks Int?     @map("duration_weeks")
  price         Decimal? @db.Decimal(10, 2)
  status        String   @default("active") @db.VarChar(20)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  studentRegistrations StudentRegistration[]
  enrollments          Enrollment[]
  classes              Class[]
  assessments          Assessment[]

  @@map("courses")
}

// ============================================
// ENROLLMENTS
// ============================================

model Enrollment {
  id                 Int       @id @default(autoincrement())
  studentId          Int       @map("student_id")
  courseId           Int       @map("course_id")
  teacherId          Int?      @map("teacher_id")
  enrollmentDate     DateTime  @default(now()) @map("enrollment_date") @db.Date
  startDate          DateTime? @map("start_date") @db.Date
  endDate            DateTime? @map("end_date") @db.Date
  status             String    @default("active") @db.VarChar(20)
  progressPercentage Int       @default(0) @map("progress_percentage")
  feePaid            Boolean   @default(false) @map("fee_paid")
  amountPaid         Decimal?  @map("amount_paid") @db.Decimal(10, 2)
  paymentMethod      String?   @map("payment_method") @db.VarChar(50)
  notes              String?
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at")
  passwordHash       String?   @map("password_hash") @db.VarChar(255)
  // Relations
  studentRegistration StudentRegistration @relation(fields: [studentId], references: [id])
  course              Course              @relation(fields: [courseId], references: [id])
  teacherRegistration TeacherRegistration? @relation(fields: [teacherId], references: [id])
  classes             Class[]
  attendances         Attendance[]
  payments            Payment[]
  assessments         Assessment[]

  @@map("enrollments")
}

// ============================================
// CLASSES / SESSIONS
// ============================================

model Class {
  id                Int       @id @default(autoincrement())
  classCode         String?   @unique @map("class_code") @db.VarChar(20)
  enrollmentId      Int       @map("enrollment_id")
  teacherId         Int?      @map("teacher_id")
  courseId          Int       @map("course_id")
  title             String    @db.VarChar(200)
  description       String?
  date              DateTime  @db.Date
  startTime         String?   @map("start_time") @db.VarChar(10)
  endTime           String?   @map("end_time") @db.VarChar(10)
  durationMinutes   Int?      @map("duration_minutes")
  status            String    @default("scheduled") @db.VarChar(20)
  meetingLink       String?   @map("meeting_link") @db.VarChar(255)
  recordingLink     String?   @map("recording_link") @db.VarChar(255)
  notes             String?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")

  // Relations
  enrollment        Enrollment @relation(fields: [enrollmentId], references: [id])
  teacher           TeacherRegistration? @relation(fields: [teacherId], references: [id])
  course            Course    @relation(fields: [courseId], references: [id])
  attendances       Attendance[]

  @@map("classes")
}

// ============================================
// ATTENDANCE
// ============================================

model Attendance {
  id                Int       @id @default(autoincrement())
  classId           Int       @map("class_id")
  studentId         Int       @map("student_id")
  enrollmentId      Int       @map("enrollment_id")
  status            String    @db.VarChar(20) // present, absent, late, excused
  checkInTime       DateTime? @map("check_in_time")
  checkOutTime      DateTime? @map("check_out_time")
  notes             String?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")

  // Relations
  class             Class     @relation(fields: [classId], references: [id])
  studentRegistration StudentRegistration @relation(fields: [studentId], references: [id])
  enrollment        Enrollment @relation(fields: [enrollmentId], references: [id])

  @@map("attendances")
}

// ============================================
// PAYMENTS / INVOICES
// ============================================

model Payment {
  id                Int       @id @default(autoincrement())
  invoiceNumber     String?   @unique @map("invoice_number") @db.VarChar(50)
  studentId         Int       @map("student_id")
  enrollmentId      Int?      @map("enrollment_id")
  amount            Decimal   @db.Decimal(10, 2)
  currency          String    @default("USD") @db.VarChar(10)
  paymentDate       DateTime  @default(now()) @map("payment_date") @db.Date
  paymentMethod     String    @map("payment_method") @db.VarChar(50)
  transactionId     String?   @map("transaction_id") @db.VarChar(100)
  status            String    @default("pending") @db.VarChar(20)
  notes             String?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")

  // Relations
  studentRegistration StudentRegistration @relation(fields: [studentId], references: [id])
  enrollment        Enrollment? @relation(fields: [enrollmentId], references: [id])

  @@map("payments")
}

// ============================================
// ASSESSMENTS / TESTS
// ============================================

model Assessment {
  id                Int       @id @default(autoincrement())
  enrollmentId      Int       @map("enrollment_id")
  studentId         Int       @map("student_id")
  courseId          Int       @map("course_id")
  title             String    @db.VarChar(200)
  description       String?
  type              String    @db.VarChar(50) // quiz, test, exam, assignment
  maxScore          Float     @map("max_score")
  score             Float?
  date              DateTime  @db.Date
  feedback          String?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")

  // Relations
  enrollment        Enrollment @relation(fields: [enrollmentId], references: [id])
  studentRegistration StudentRegistration @relation(fields: [studentId], references: [id])
  course            Course    @relation(fields: [courseId], references: [id])

  @@map("assessments")
}

// ============================================
// ADMIN USERS
// ============================================

model AdminUser {
  id           Int       @id @default(autoincrement())
  username     String    @unique @db.VarChar(50)
  email        String    @unique @db.VarChar(100)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  fullName     String    @map("full_name") @db.VarChar(100)
  role         String    @default("editor") @db.VarChar(30)
  lastLogin    DateTime? @map("last_login")
  status       String    @default("active") @db.VarChar(20)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  // Relations
  reviewedApplications TeacherApplication[] @relation("TeacherReviewer")

  @@map("admin_users")
}

// ============================================
// NEWSLETTER SUBSCRIBERS
// ============================================

model NewsletterSubscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique @db.VarChar(100)
  status    String   @default("active") @db.VarChar(20)
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("newsletter_subscribers")
}

// ============================================
// SITE SETTINGS
// ============================================

model SiteSetting {
  id          Int      @id @default(autoincrement())
  key         String   @unique @db.VarChar(100)
  value       String   @db.Text
  group       String?  @db.VarChar(50)
  description String?
  isPublic    Boolean  @default(false) @map("is_public")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("site_settings")
}

// ============================================
// ACTIVITY LOGS
// ============================================

model ActivityLog {
  id          Int      @id @default(autoincrement())
  userId      Int?     @map("user_id")
  userType    String   @map("user_type") @db.VarChar(20) // admin, teacher, student
  action      String   @db.VarChar(50)
  entity      String?  @db.VarChar(50)
  entityId    String?  @map("entity_id") @db.VarChar(50)
  details     String?
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("activity_logs")
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}